# SwissSolarForecast Configuration
# =================================
# This file contains non-secret configuration parameters.
# Edit via File Editor or VS Code at: /addon_configs/swiss-solar-forecast/
#
# SECRETS (tokens) are configured in the add-on Configuration tab, NOT in this file.
#
# After editing, restart the add-on to apply changes.

# InfluxDB connection (token in Configuration tab, not here!)
influxdb:
  host: "192.168.0.203"
  port: 8087
  org: "energymanagement"
  bucket: "pv_forecast"

# Location settings
location:
  latitude: 47.475
  longitude: 7.767
  altitude: 330
  timezone: "Europe/Zurich"

# Panel definitions — manufacturer datasheet ground truth ONLY (nameplate pdc0,
# datasheet gamma). Corrections (soiling, shading, drift) belong to the shading
# layer, never here. Datasheet sources: Documents/swiss-solar-forecast-fsd.md App. A.
panels:
  - id: "AXITEC455"
    model: "AXITEC AC-455MH/144V (AXIpremium XL HC)"
    pdc0: 455
    gamma_pdc: -0.0035

  - id: "LONGI350"
    model: "LONGi LR4-60HPB-350M (Hi-MO 4m)"
    pdc0: 350
    gamma_pdc: -0.0037

  - id: "MB385"
    model: "Meyer Burger White 385 (HJT)"
    pdc0: 385
    gamma_pdc: -0.00259

# Plant definitions with inverters and strings
plants:
  - name: "House"
    inverters:
      - name: "EastWest"        # Huawei 10 kW hybrid; East on PV1, West on PV2
        max_power: 10000
        efficiency: 0.98
        strings:
          - name: "East"
            azimuth: 103.3
            tilt: 15
            panel: "AXITEC455"
            count: 8
          - name: "West"
            azimuth: 283.3
            tilt: 15
            panel: "AXITEC455"
            count: 9

      - name: "South"           # Enphase microinverters, one per panel, 300 W AC each
        max_power: 1500         # 5 micros x 300 W (aggregate; longterm KPI only)
        micro_ac_cap: 308       # per-panel AC clip — measured ~308 W/panel ceiling
        efficiency: 0.97
        strings:
          - name: "SouthFront"
            azimuth: 193.3
            tilt: 70
            panel: "LONGI350"
            count: 3
          - name: "SouthBack"   # adjustable mount — tilt reflects the current setting
            azimuth: 193.3
            tilt: 30
            panel: "LONGI350"
            count: 1
          - name: "SouthBackMB" # adjustable mount — tilt reflects the current setting
            azimuth: 193.3
            tilt: 30
            panel: "MB385"
            count: 1

# Schedule settings (cron in UTC)
schedule:
  ch1_cron: "30 2,5,8,11,14,17,20,23 * * *"
  # CH2: run+4h. CH2's full 120h horizon isn't published until ~run+3h, so an
  # earlier fetch hits non-monotonic publish gaps (false "GAPS inside range" warnings).
  ch2_cron: "0 4,10,16,22 * * *"
  calculator_interval_minutes: 15

# Storage settings
storage:
  data_path: "/share/swiss-solar-forecast"
  max_storage_gb: 3.0
  cleanup_old_runs: true

# Forecast accuracy tracking (FSD Chapter 5.3)
# Phase 1: Snapshots forecast at 21:00 local time with decision context
accuracy_tracker:
  enabled: true
  ha_url: "http://supervisor/core"  # Home Assistant API URL
  soc_entity: "sensor.battery_state_of_capacity"
  discharge_control_entity: "number.battery_maximum_discharging_power"

# Logging level: debug, info, warning, error
log_level: "info"
