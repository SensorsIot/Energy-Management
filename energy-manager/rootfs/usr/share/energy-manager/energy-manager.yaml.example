# EnergyManager Configuration
# ============================
# This file contains non-secret configuration parameters.
# Edit via File Editor or VS Code at: /addon_configs/energy-manager/
#
# SECRETS (tokens, passwords) are configured in the add-on Configuration tab,
# NOT in this file. They are securely managed by Home Assistant.
#
# After editing, restart the add-on to apply changes.

# InfluxDB connection for forecasts
# NOTE: The token is configured in the add-on Configuration tab (not here)
influxdb:
  host: "192.168.0.203"
  port: 8087
  org: "energymanagement"
  pv_bucket: "pv_forecast"
  load_bucket: "load_forecast"
  output_bucket: "energy_manager"
  soc_bucket: "HomeData"
  soc_measurement: "Energy"
  soc_field: "BATT_Level"

# Battery settings
battery:
  capacity_kwh: 10.0
  reserve_percent: 10
  # Buy-protection floor: home-battery SOC kept to avoid grid purchases
  # (shared by Topics 1/2/3; FSD 4.2.2/4.3.6).
  no_buy_floor_percent: 20
  charge_efficiency: 0.95
  discharge_efficiency: 0.95
  max_charge_w: 5000
  max_discharge_w: 5000
  soc_entity: "sensor.battery_state_of_capacity"
  discharge_control_entity: "number.battery_maximum_discharging_power"
  # Export-peak shaving: defer battery charging so its headroom absorbs
  # the midday export peak (only when the car is disconnected or full).
  # Re-evaluated every 15 min. See FSD 4.2.3.
  # Master switch for the whole shaving path (day-mode latch, B0 gate, BR
  # reserve floor, water-fill). false → the battery charges greedily at
  # max_charge_w every cycle. Read at startup, so changing it needs an add-on
  # restart. The longevity ceiling (longevity_enabled, FSD 4.2.4) is a separate
  # feature and still caps charging at battery_target_soc.
  charge_shaving_enabled: true
  # Charge power (W) used while shaving the export peak (use case B). Lower
  # than max_charge_w on purpose: a gentler C-rate is easier on the battery
  # and spreads absorption over more intervals → flatter feed-in. Use case A
  # (car connected & not full) still releases to max_charge_w.
  charge_shaving_power_w: 2500
  # Reserve floor (BR): the minimum SOC the battery reaches before shaving is
  # allowed to defer it at all. A shaving day bets the morning surplus on a
  # midday peak that may not arrive; below this SOC the bet is off and the
  # surplus is banked at max_charge_w (full power — the fast fill matters more
  # than the gentle C-rate down here). Above it the water-fill
  # resumes and the rest of the headroom is held for the peak. Set to 0 to
  # disable the floor (pure water-fill). See FSD 4.2.3 BR.
  charge_shaving_reserve_soc: 20
  # Marginal-day gate (B0): shaving only runs on an abundant day — one where
  # the battery is forecast to reach full today even under a conservative,
  # low-production estimate (p10 PV vs p50 load). On a marginal shoulder-season
  # day it would not fill under that pessimistic forecast → charge greedily, no
  # shaving. The p10/p50 forecast band is the safety margin. See FSD 4.2.3 B0.
  # Fill-margin: shave only when the day's surplus exceeds the headroom by at
  # least this factor (1.2 = 20% more than needed to fill). A day that only
  # just fills, or fills near sunset, has no real export peak worth deferring
  # for → it routes to greedy charging instead.
  charge_shaving_fill_margin: 1.2
  # Day-mode decision hour (local, Europe/Zurich): the shave-vs-car-day choice
  # is made ONCE per day at this hour, then frozen until midnight. If the car
  # is connected & at/above its target at this time → shaving day; if it needs
  # energy or is absent → car day (battery charges greedily all day). See FSD
  # 4.2.3 day-mode.
  shaving_decision_hour: 8
  # Fail-safe: if the PV forecast heartbeat is older than this many minutes,
  # the forecast is stale/untrusted (SwissSolarForecast keeps the last-good
  # forecast when the weather download is incomplete/stale) → don't shave,
  # charge greedily (the safe default that never under-fills the battery).
  forecast_max_age_minutes: 120
  charge_control_entity: "number.battery_maximum_charging_power"
  # Longevity ceiling (FSD 4.2.4): hold the LFP pack below full to cut high-SOC
  # dwell. The ceiling is a goal you choose, not a computed value — the one
  # exception is the periodic calibration charge, which lets the pack reach the
  # top so the BMS can re-anchor its SOC estimate against the flat LFP voltage
  # curve. Enforced by the inverter's native end-of-charge SOC register (which
  # accepts only 90-100%) and backed in software via charge_control_entity
  # (limit 0 at/above the ceiling), which is what a sub-90 ceiling would rely on.
  longevity_enabled: false          # off -> no cap; the register is held at 100%
  longevity_ceiling: 90             # the goal (%) while enabled
  longevity_calibration_days: 7     # force a 100% charge this long after the last >=99% (LFP BMS)
  # Dashboard sensor that surfaces the combined battery reasoning
  # (discharge + charge-shaving). Advisory only. See FSD 4.6.4.
  battery_decision_entity: "sensor.battery_decision"

# Electricity tariff settings
tariff:
  weekday_cheap_start: "21:00"
  weekday_cheap_end: "06:00"
  weekend_all_day_cheap: true
  holidays: []

# Appliance control settings
appliances:
  power_w: 2500
  energy_wh: 1500

# Sensor entities for appliance signal calculation
sensors:
  pv_power: "sensor.solar_pv_total_ac_power"
  load_power: "sensor.load_power"
  # Master switch for the M-Bus grid meter (FSD 4.7.5). false takes the reader
  # out of service entirely: the entity is never read, the staleness watchdog
  # never runs, and every grid read comes from the DTSU meter. Set this while
  # the gPlug reader is knowingly out so a dead meter stops alerting on every
  # add-on restart. Read at startup — a change needs a restart.
  mbus_enabled: true
  mbus_grid_power: "sensor.grid_power"            # EBL smart meter via gPlug M-Bus
  dtsu_grid_power: "sensor.power_meter_active_power"  # Huawei DTSU666-H at inverter
  appliance_signal: "sensor.appliance_signal"

# EV charging settings (FSD 4.5)
ev_charging:
  enabled: true

  # Wallbox power limits (1-phase: 1400–3700, 3-phase: 4100–11000, switchable: 1400–11000)
  min_power_w: 1400
  max_power_w: 11000
  # EV safety rule: charging is allowed only while the home-battery SOC
  # forecast stays >= reserve_percent across the next 48 h (with the
  # candidate EV load subtracted). Independent of battery.reserve_percent
  # (which gates nightly discharge) — set this higher to keep a buffer
  # for house consumption before diverting surplus to the car.
  reserve_percent: 20
  auto_reset_timeout_min: 5         # Minutes of 0W before auto-revert to solar

  # Entity overrides (defaults should work for most setups)
  # mode_entity: "input_select.ev_charging_mode"
  # charge_status_entity: "sensor.ev_charge_status"
  # wallbox_status_entity: "sensor.wallbox_status"

# Smart car SOC (reads from smarthashtag HA custom integration)
# Requires: https://github.com/DasBasti/SmartHashtag installed in HA
smart_car:
  enabled: true
  soc_entity: "sensor.smart_battery"
  capacity_kwh: 100.0          # EV usable battery capacity
  charge_efficiency: 0.9       # end-to-end surplus→car efficiency (Car SOC Forecast)

# Runtime settings (FSD 4.7.6) — six values the dashboard can change without
# editing this file or restarting the add-on. The values set above stay the
# DEFAULTS: each applies whenever its helper is missing, `unknown` or
# `unavailable`, so a setup with no helpers at all behaves exactly as before.
# Re-read once per 15-min cycle.
#
# A helper that is absent must never read as "off" — that would disable a
# feature because an entity failed to load. Only a definite on/off wins.
#
# Uncomment to point a setting at a different entity.
settings:
  # shaving_enabled: "input_boolean.battery_shaving_enabled"        # battery.charge_shaving_enabled
  # longevity_enabled: "input_boolean.battery_longevity_enabled"    # battery.longevity_enabled
  # longevity_ceiling: "input_number.battery_longevity_ceiling"     # battery.longevity_ceiling
  # shaving_decision_hour: "input_number.shaving_decision_hour"     # battery.shaving_decision_hour
  # shaving_reserve_soc: "input_number.shaving_reserve_soc"         # battery.charge_shaving_reserve_soc
  # mbus_enabled: "input_boolean.mbus_reader_enabled"               # sensors.mbus_enabled

# Schedule settings
schedule:
  update_interval_minutes: 15

# Logging level: debug, info, warning, error
log_level: "info"
